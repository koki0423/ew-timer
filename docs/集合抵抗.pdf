         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">152-155.indd</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">KOA's Standard Thick Film Resistor Networks RKL, RKC, RKH.Various types of standard circuits in different sizes and power are available. (Seated height 5.08mm, 6.5mm, 10.7mm Max.)For automatic insertion machines, stick magazines (the tip of lead terminal is cut to a V shape) and taping packages (TBA:All leads taping, TPA:3 leads taping) are applicable. EU-RoHS compliant.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>KOA Corporation</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>Standard Thick Film Resistor Networks</rdf:li>
               <rdf:li>various standard circuits</rdf:li>
               <rdf:li>stick magazines</rdf:li>
               <rdf:li>automatic insertion</rdf:li>
               <rdf:li>EU-RoHS</rdf:li>
            </rdf:Bag>
         </dc:subject>
